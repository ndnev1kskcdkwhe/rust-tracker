# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rust_tracker?schema=public"

# Only needed on hosted setups where DATABASE_URL points at a connection pooler
# (Neon/Supabase). Migrations need a direct, non-pooled connection. Leave unset locally —
# prisma.config.ts falls back to DATABASE_URL.
DIRECT_URL=""

# NextAuth
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Steam Web API — https://steamcommunity.com/dev/apikey
STEAM_API_KEY=""

# BattleMetrics API — https://www.battlemetrics.com/developers
BATTLEMETRICS_API_KEY=""

# RustMaps API — https://rustmaps.com/dashboard
RUSTMAPS_API_KEY=""
